# Database Configuration (PostgreSQL for production/dev)
# e.g., postgresql://postgres:postgres@localhost:5432/projecthub
# or sqlite:///./projecthub.db for local lightweight testing
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/projecthub

# JWT Security
SECRET_KEY=change_this_to_a_super_secret_key_at_least_32_chars_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Initial Admin Seeding
ADMIN_EMAIL=admin@projecthub.edu
ADMIN_PASSWORD=AdminPass123!

# Environment (development, testing, production)
ENVIRONMENT=development
